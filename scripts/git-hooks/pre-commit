#!/bin/sh
# Runs the full check (scripts/check.ps1) before every commit; a failure
# stops the commit. Commits that change only docs (docs/ or *.md) skip it.
#
# Turn it on once per clone:  git config core.hooksPath scripts/git-hooks

if ! git diff --cached --name-only | grep -qvE '^docs/|\.md$'; then
    echo "pre-commit: docs only, skipping the checks."
    exit 0
fi

if command -v powershell.exe >/dev/null 2>&1; then
    shell=powershell.exe
else
    shell=pwsh
fi
echo "pre-commit: running scripts/check.ps1 (about a minute)..."
exec "$shell" -NoProfile -ExecutionPolicy Bypass -File scripts/check.ps1
