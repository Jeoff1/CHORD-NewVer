DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

DB_NAME=chord_newver_db
DB_USER=chord_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Spotify app credentials, from the Spotify developer dashboard. Song search
# is unavailable without them.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Encrypts each user's Spotify tokens in the database. Make one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it disconnects every user's Spotify account. Connecting Spotify
# is unavailable without it.
SPOTIFY_TOKEN_KEY=
# Where Spotify sends people back after they connect. It must match a
# Redirect URI in the Spotify dashboard exactly. Spotify accepts plain http
# only for 127.0.0.1, not "localhost". Without it, CHORD uses the address
# the page was opened on.
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/worship/songs/spotify/callback/

# Song analysis: "onnx" (run `python manage.py download_models` first) or
# "keyword" (a light stand-in that needs no model files).
ML_ENGINE=onnx
# ML_MODELS_DIR=ml_models

# How CHORD names itself to LRCLIB (the lyrics service): app, version and a
# homepage where the operators can reach you.
# LRCLIB_USER_AGENT=CHORD worship planner/0.4 (https://example.org/contact)

# Email (optional). Without these, emails print to the console.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_EMAIL_USE_TLS=True
# DJANGO_DEFAULT_FROM_EMAIL=
